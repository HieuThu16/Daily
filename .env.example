# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Web Push: sinh bằng `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=

# Sync review phim (`npm run crawl:reviews`) — chỉ chạy phía server, KHÔNG có
# tiền tố VITE_ nên không lọt vào bundle.
# YOUTUBE_API_KEY: Google Cloud Console → bật YouTube Data API v3 → tạo API key.
YOUTUBE_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TIKTOK_ACCESS_TOKEN=

# Cloudinary Configuration (Lưu trữ ảnh & video miễn phí)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
