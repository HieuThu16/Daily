{
  "name": "my-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const fs=require('fs'),p=require('path');const d=new Date(),v='v2.4.'+String(d.getFullYear()).slice(-2)+String(d.getMonth()+1).padStart(2,'0')+String(d.getDate()).padStart(2,'0')+'.'+String(d.getHours()).padStart(2,'0')+String(d.getMinutes()).padStart(2,'0');fs.writeFileSync(p.join('public','version.json'),JSON.stringify({version:v,buildTime:d.toISOString()},null,2));console.log('version.json →',v)\" && node --import tsx tools/data/split_bl_data.mjs && node --import tsx tools/data/split_ngontinh_data.mjs && node --import tsx tools/data/split_extra_manga.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "crawl:ngontinh": "node tools/crawl/crawl_ngontinh.js",
    "crawl:teamsany": "node tools/crawl/crawl_teamsany.js",
    "crawl:bl": "node tools/crawl/crawl_all_bl.js",
    "crawl:reviews": "node --import tsx tools/crawl/crawl_review_series.mjs",
    "crawl:tiktok": "node tools/crawl/crawl_tiktok.mjs",
    "crawl:tvshow": "node --import tsx tools/crawl/crawl_tvshow_channels.mjs",
    "backfill:durations": "node tools/data/backfill_video_durations.mjs",
    "split:bl": "node --import tsx tools/data/split_bl_data.mjs",
    "split:ngontinh": "node --import tsx tools/data/split_ngontinh_data.mjs",
    "import:books": "node --import tsx tools/data/import_books_full_v2.mjs",
    "lint": "eslint . --max-warnings 9999",
    "lint:strict": "eslint .",
    "build:ngontinh": "node --import tsx tools/data/build_ngontinh_index.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@types/leaflet": "^1.9.22",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
}
