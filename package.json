{
  "name": "my-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node --import tsx split_bl_data.mjs && node --import tsx split_ngontinh_data.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "crawl:ngontinh": "node crawl_ngontinh.js",
    "crawl:teamsany": "node crawl_teamsany.js",
    "crawl:bl": "node crawl_all_bl.js",
    "crawl:reviews": "node --import tsx crawl_review_series.mjs",
    "crawl:tvshow": "node --import tsx crawl_tvshow_channels.mjs",
    "split:bl": "node --import tsx split_bl_data.mjs",
    "split:ngontinh": "node --import tsx split_ngontinh_data.mjs",
    "import:books": "node --import tsx import_books_full_v2.mjs",
    "import:metadata": "node create_books_simple.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
}
