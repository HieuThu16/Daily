{
  "rewrites": [
    {
      "source": "/api/audio-proxy",
      "destination": "/api/link-preview?audio=1"
    },
    {
      "source": "/api/cloudinary-upload",
      "destination": "/api/storage?action=cloudinary-upload"
    },
    {
      "source": "/api/cloudinary-delete",
      "destination": "/api/storage?action=cloudinary-delete"
    },
    {
      "source": "/api/cloudinary-usage",
      "destination": "/api/storage?action=cloudinary-usage"
    },
    {
      "source": "/api/storage-delete",
      "destination": "/api/storage?action=storage-delete"
    },
    {
      "source": "/api/sync-review",
      "destination": "/api/sync-channel?type=review"
    },
    {
      "source": "/api/sync-tvshow",
      "destination": "/api/sync-channel?type=tvshow"
    },
    {
      "source": "/api/tiktok-video",
      "destination": "/api/crawl-tiktok?action=video"
    },
    {
      "source": "/((?!api/|assets/|manifest\\.webmanifest$|registerSW\\.js$|sw\\.js$|version\\.json$|workbox-.*\\.js$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-sync",
      "schedule": "0 18 * * *"
    }
  ]
}
